# make setup copies this file to .env and generates the two secrets.
POSTGRES_PASSWORD=change-me
AXOLOT_SECRET=change-me
AXOLOT_PORT=5090
AXOLOT_WEB_PORT=5191
# Ollama on the host, seen from the container.
OLLAMA_URL=http://host.docker.internal:11434
# Claude subscription bridge on the host; make bridge adds AXOLOT_BRIDGE_TOKEN.
AXOLOT_BRIDGE_PORT=5092
